HERMES_BASE_URL=http://localhost:8000/v1
HERMES_API_KEY=local
HERMES_MODEL=your-judge-and-synthesis-model-id

# Legacy single-worker mode: set these only if the three specialist blocks below
# are all unset. Kept for backwards compatibility.
# NEMOTRON_BASE_URL=http://localhost:8001/v1
# NEMOTRON_API_KEY=local
# NEMOTRON_MODEL=your-nemotron-model-id

# Three-model AnnealMesh mode. Serve each model behind an OpenAI-compatible endpoint.
# Model identifiers must match the IDs exposed by each endpoint's /v1/models.
NEMOTRON_LIGHTNING_BASE_URL=http://localhost:8001/v1
NEMOTRON_LIGHTNING_API_KEY=local
NEMOTRON_LIGHTNING_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16

NEMOTRON_BOLT_BASE_URL=http://localhost:8002/v1
NEMOTRON_BOLT_API_KEY=local
NEMOTRON_BOLT_MODEL=your-served-nemotron-bolt-model-id

NEMOTRON_SUPER_VL_BASE_URL=http://localhost:8003/v1
NEMOTRON_SUPER_VL_API_KEY=local
NEMOTRON_SUPER_VL_MODEL=your-served-nemotron-super-vl-model-id

# Use at least 3 candidate workers so every specialist contributes each round.
MESH_WIDTH=4
MESH_ROUNDS=3
MESH_SURVIVORS=2
MESH_TEMPERATURE=0.85
MESH_MIN_TEMPERATURE=0.20
MESH_TIMEOUT_SECONDS=180

# NVIDIA Speech NIM HTTP services (ASR and TTS may be separate deployments).
ASR_BASE_URL=http://localhost:9000
TTS_BASE_URL=http://localhost:9001
SPEECH_API_KEY=
TTS_VOICE=English-US-Magpie-Flow.Female-1
TTS_LANGUAGE=en-US
TTS_SAMPLE_RATE=22050
